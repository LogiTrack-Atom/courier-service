          "500": {
            "description": "Error interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Bearer ausente, inválido o vencido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                },
                "example": "Bearer"
              }
            }
          },
          "403": {
            "description": "Rol o pertenencia insuficientes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "x-roles": [
          "ADMIN",
          "REPARTIDOR"
        ],
        "description": " ADMIN consulta cualquier registro; REPARTIDOR consulta únicamente su asociación local por sub, sin equiparar sub al UUID del dominio."
      },
      "put": {
        "operationId": "actualizarRepartidor",
        "summary": "Actualiza nombre y vehículo",
        "description": "Conserva UUID, asociación de usuario, fecha de creación y estado. Un cambio de estado requiere PATCH explícito.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
