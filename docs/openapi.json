{
  "openapi": "3.1.0",
  "info": {
    "title": "LogiTrack courier-service",
    "version": "0.2.0",
    "description": "Altas y consultas del Sprint02. JWT y pertenencia se incorporan en la issue #4."
  },
  "servers": [
    {
      "url": "http://localhost:8081"
    }
  ],
  "paths": {
    "/api/v1/repartidores": {
      "post": {
        "operationId": "crearRepartidor",
        "summary": "Registra un repartidor ACTIVO",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RepartidorRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Repartidor registrado",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RepartidorResponse"
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Conflicto",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "415": {
            "description": "Tipo de contenido no admitido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Error interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listarRepartidores",
        "summary": "Lista repartidores con filtro opcional",
        "parameters": [
          {
            "name": "estado",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ACTIVO",
                "INACTIVO"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista, vacía si no hay coincidencias",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RepartidorResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Error interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/repartidores/{id}": {
      "get": {
        "operationId": "obtenerRepartidor",
        "summary": "Consulta un repartidor",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Repartidor encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RepartidorResponse"
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Repartidor inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Error interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RepartidorRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nombre",
          "tipoVehiculo"
        ],
        "properties": {
          "nombre": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": ".*\\S.*"
          },
          "tipoVehiculo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": ".*\\S.*"
          }
        },
        "example": {
          "nombre": "Repartidor de ejemplo",
          "tipoVehiculo": "Moto"
        }
      },
      "RepartidorResponse": {
        "type": "object",
        "required": [
          "id",
          "nombre",
          "tipoVehiculo",
          "estado",
          "createdAt",
          "updatedAt"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nombre": {
            "type": "string"
          },
          "tipoVehiculo": {
            "type": "string"
          },
          "estado": {
            "type": "string",
            "enum": [
              "ACTIVO",
              "INACTIVO"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "example": {
          "id": "bf9c4dd3-a149-452c-bf89-158f0889b149",
          "nombre": "Repartidor de ejemplo",
          "tipoVehiculo": "Moto",
          "estado": "ACTIVO",
          "createdAt": "2026-10-27T12:00:00.123456Z",
          "updatedAt": "2026-10-27T12:00:00.123456Z"
        }
      },
      "ApiError": {
        "type": "object",
        "required": [
          "timestamp",
          "status",
          "error",
          "mensaje",
          "detalles"
        ],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          },
          "mensaje": {
            "type": "string"
          },
          "detalles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "example": {
          "timestamp": "2026-10-27T12:00:00Z",
          "status": 404,
          "error": "Not Found",
          "mensaje": "No se encontró el repartidor solicitado.",
          "detalles": []
        }
      }
    }
  }
}
