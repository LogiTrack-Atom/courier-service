# Spring Boot local: exportar estas variables; no carga .env automáticamente.
DB_URL=jdbc:mysql://localhost:3308/courier_db?serverTimezone=UTC
DB_USERNAME=courier_app
DB_PASSWORD=
JWT_PUBLIC_KEY_LOCATION=file:/ruta/externa/public.pem
SECURITY_SERVICE_URL=http://localhost:8082
SPRING_PROFILES_ACTIVE=dev
CONFIG_SERVER_URL=http://localhost:8085
CONFIG_LABEL=develop
COURIER_SERVER_PORT=8081

# Docker Compose: leerá .env o un --env-file externo.
MYSQL_DATABASE=courier_db
MYSQL_USER=courier_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_HOST_PORT=3308
APP_PORT=8081
JWT_PUBLIC_KEY_FILE=/ruta/externa/public.pem
# local aísla solo el componente; dev/prod requieren Config Server accesible.
COURIER_PROFILE=local
# En Docker, CONFIG_SERVER_URL debe apuntar a http://configserver:8085
# o a otro origen accesible desde el contenedor; SECURITY_SERVICE_URL sigue la misma regla.
TZ=UTC
