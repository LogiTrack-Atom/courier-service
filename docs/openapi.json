                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "415": {
            "description": "Tipo de contenido no admitido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Error interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Bearer ausente, inválido o vencido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                },
                "example": "Bearer"
              }
            }
          },
          "403": {
            "description": "Rol o pertenencia insuficientes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "x-roles": [
          "ADMIN"
        ]
      }
    },
    "/api/v1/repartidores/{id}/disponibilidad": {
      "get": {
        "operationId": "consultarDisponibilidadRepartidor",
        "summary": "Consulta disponibilidad sin efectos secundarios",
        "description": "Disponible significa estado ACTIVO. No reserva, no calcula carga ni consulta otros servicios. INACTIVO devuelve 200 con disponible false; un UUID inexistente devuelve 404. ADMIN consulta cualquier registro; REPARTIDOR consulta únicamente su asociación local por sub, sin equiparar sub al UUID del dominio.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Disponibilidad operativa",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DisponibilidadRepartidorResponse"
                },
                "examples": {
                  "activo": {
                    "value": {
                      "repartidorId": "bf9c4dd3-a149-452c-bf89-158f0889b149",
                      "estado": "ACTIVO",
                      "disponible": true
                    }
                  },
                  "inactivo": {
                    "value": {
                      "repartidorId": "bf9c4dd3-a149-452c-bf89-158f0889b149",
                      "estado": "INACTIVO",
                      "disponible": false
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Repartidor inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Error interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Bearer ausente, inválido o vencido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                },
                "example": "Bearer"
              }
            }
          },
          "403": {
            "description": "Rol o pertenencia insuficientes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "x-roles": [
          "ADMIN",
          "REPARTIDOR"
        ]
      }
    },
    "/api/v1/repartidores/{id}/usuario": {
      "put": {
        "operationId": "asociarUsuarioRepartidor",
        "summary": "Vincula explícitamente una cuenta REPARTIDOR existente",
        "description": "Solo ADMIN. Se verifica cuenta y rol en security antes de la escritura local. Una cuenta no se vincula a dos repartidores; otra asociación existente no se reemplaza (409). Repetir la misma asociación devuelve 200 sin consultar al proveedor ni modificar auditoría. La respuesta es el DTO de dominio y no expone usuarioId.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AsociacionUsuarioRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Asociación persistida o repetición idempotente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RepartidorResponse"
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Repartidor o cuenta inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Cuenta ya vinculada o asociación incompatible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "415": {
            "description": "Tipo de contenido no admitido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "La cuenta no tiene rol REPARTIDOR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "502": {
            "description": "Respuesta de security incompatible, redirección o 401/403 inesperado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Security no disponible, timeout, 429 o 5xx",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Error interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Bearer ausente, inválido o vencido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                },
                "example": "Bearer"
              }
            }
          },
          "403": {
            "description": "Rol o pertenencia insuficientes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "x-roles": [
          "ADMIN"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "RepartidorRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nombre",
          "tipoVehiculo"
        ],
        "properties": {
          "nombre": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": ".*\\S.*"
          },
          "tipoVehiculo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": ".*\\S.*"
          }
        },
        "example": {
          "nombre": "Repartidor de ejemplo",
          "tipoVehiculo": "Moto"
        }
      },
      "RepartidorResponse": {
        "type": "object",
        "required": [
          "id",
          "nombre",
          "tipoVehiculo",
          "estado",
          "createdAt",
          "updatedAt"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nombre": {
            "type": "string"
          },
          "tipoVehiculo": {
            "type": "string"
          },
          "estado": {
            "type": "string",
            "enum": [
              "ACTIVO",
              "INACTIVO"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "example": {
          "id": "bf9c4dd3-a149-452c-bf89-158f0889b149",
          "nombre": "Repartidor de ejemplo",
          "tipoVehiculo": "Moto",
          "estado": "ACTIVO",
          "createdAt": "2026-10-27T12:00:00.123456Z",
          "updatedAt": "2026-10-27T12:00:00.123456Z"
        }
      },
      "ApiError": {
        "type": "object",
        "required": [
          "timestamp",
          "status",
          "error",
          "mensaje",
          "detalles"
        ],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          },
          "mensaje": {
            "type": "string"
          },
          "detalles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "example": {
          "timestamp": "2026-10-27T12:00:00Z",
          "status": 404,
          "error": "Not Found",
          "mensaje": "No se encontró el repartidor solicitado.",
          "detalles": []
        }
      },
      "EstadoRepartidorRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "estado"
        ],
        "properties": {
          "estado": {
            "type": "string",
            "enum": [
              "ACTIVO",
              "INACTIVO"
            ]
          }
        },
        "example": {
          "estado": "INACTIVO"
        }
      },
      "DisponibilidadRepartidorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repartidorId",
          "estado",
          "disponible"
        ],
        "properties": {
          "repartidorId": {
            "type": "string",
            "format": "uuid"
          },
          "estado": {
            "type": "string",
            "enum": [
              "ACTIVO",
              "INACTIVO"
            ]
          },
          "disponible": {
            "type": "boolean"
          }
        },
        "description": "disponible es true exactamente cuando estado es ACTIVO.",
        "example": {
          "repartidorId": "bf9c4dd3-a149-452c-bf89-158f0889b149",
          "estado": "ACTIVO",
          "disponible": true
        }
      },
      "AsociacionUsuarioRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "usuarioId"
        ],
        "properties": {
          "usuarioId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "example": {
          "usuarioId": "8f3fd53c-83a4-4cdd-bf50-4b34dca59a81"
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token emitido por security-service, con sub UUID y roles explícitos. Se valida localmente con la clave pública."
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}
