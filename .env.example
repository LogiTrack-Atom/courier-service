# Copiar a ".env" (cp .env.example .env) y completar. NO subir ".env" al repositorio.

# --- MySQL ---
MYSQL_DATABASE=courier_db
MYSQL_USER=courier_user
MYSQL_PASSWORD=cambiar_password
MYSQL_ROOT_PASSWORD=cambiar_root_password
MYSQL_HOST_PORT=3308

# --- Aplicación ---
APP_PORT=8081
# update mientras no existan scripts SQL de esquema; luego pasar a "validate" o "none"
JPA_DDL_AUTO=update
TZ=UTC